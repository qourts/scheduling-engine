{
  "name": "@qourts/scheduling-engine",
  "version": "0.1.0",
  "description": "Deterministic tournament scheduling and match progression engine for Qourts.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "bench": "npm run build && node bench/run.mjs",
    "acceptance": "npm run build && node bench/acceptance.mjs --write"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "fast-check": "^3.23.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "apps/*"
  ]
}
